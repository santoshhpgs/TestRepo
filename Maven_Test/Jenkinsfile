pipeline {
    agent any

    options {
        timestamps()
        buildDiscarder(logRotator(numToKeepStr: '20'))
    }

    // If Maven is managed as a Jenkins global tool rather than being on the
    // agent's PATH, uncomment this and set the name to match your
    // "Manage Jenkins > Tools > Maven installations" entry.
    // tools {
    //     maven 'Maven 3'
    // }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Build & Test') {
            steps {
                script {
                    // Run the Maven build, tee the full output to build.log,
                    // and capture the real exit code even through the pipe.
                    def status = sh(
                        script: '''
                            set -o pipefail
                            mvn -B clean test 2>&1 | tee build.log
                        ''',
                        returnStatus: true
                    )
                    if (status != 0) {
                        currentBuild.result = 'FAILURE'
                    }
                }
            }
        }
    }

    post {
        always {
            archiveArtifacts artifacts: 'build.log', allowEmptyArchive: true
            script {
                def result = currentBuild.currentResult // SUCCESS, FAILURE, UNSTABLE, ...

                sh 'chmod +x scripts/analyze_build_log.sh'
                def summary = sh(
                    script: "scripts/analyze_build_log.sh build.log ${result}",
                    returnStdout: true
                ).trim()

                def banner = (result == 'SUCCESS')
                    ? '✅ Everything looks good'
                    : "❌ ${result} — see BUILD ANALYSIS below / summary.txt artifact"

                echo '================ BUILD ANALYSIS ================'
                echo summary
                echo '=================================================='

                // Fallback #1: repeat a loud, greppable banner as the LAST
                // lines of console output. Jenkins' Console Output page
                // shows a finished build's full log with no auto-scroll, so
                // this is the part you land on / see without hunting for it,
                // and it's an easy Ctrl+F target ("BUILD RESULT") either way.
                echo '#################################################'
                echo "##  BUILD RESULT: ${banner}"
                echo '#################################################'

                // Fallback #2: a standalone summary.txt artifact — open it
                // directly from the build's "Build Artifacts" list with one
                // click, no console log scrolling/searching required at all.
                writeFile file: 'summary.txt', text: "${banner}\n\n${summary}\n"
                archiveArtifacts artifacts: 'summary.txt', allowEmptyArchive: true

                currentBuild.description = banner
            }
        }
    }
}
